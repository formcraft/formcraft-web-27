# Copy to .env.local (git-ignored) and fill in from Firebase console → Project settings → Your apps.
# These are public web-app values, not secrets. Secrets live only in Cloud Functions secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FUNCTIONS_REGION=
VITE_USE_EMULATORS=true
# the site's address (leave empty for https://formcraftdesignconstruction.com); set it only for a test copy of the site
VITE_SITE_URL=
# true = every form goes through the submitLead Cloud Function (needs Blaze + deployed functions)
VITE_FORMS_VIA_FUNCTIONS=false
