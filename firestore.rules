rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    // The owner (Emlyn Atochon): the only person who manages the team. Claim set once with
    // scripts/set-admin.js --owner, never from the website.
    function isSiteOwner() { return signedIn() && request.auth.token.owner == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function str(field, max) { return request.resource.data[field] is string
                                 && request.resource.data[field].size() > 0
                                 && request.resource.data[field].size() <= max; }
    // Marketing team (custom claim role: "marketing", set from Admin → Team) or an admin:
    // reads and works the leads, edits site content.
    function isMarketing() { return isAdmin() || (signedIn() && request.auth.token.role == 'marketing'); }
    // Editors (role "editor") draft social posts in Admin → Studio; marketing and admins approve
    function isEditor() { return isMarketing() || (signedIn() && request.auth.token.role == 'editor'); }
    function editorStatus(s) { return s in ['idea', 'draft', 'review']; }
    // optional string field: absent, or a string of at most `max` characters (may be empty)
    function optStr(field, max) { return !(field in request.resource.data)
                                    || (request.resource.data[field] is string && request.resource.data[field].size() <= max); }
    // where the visitor came from (src/lib/attribution.js) and the page the form was sent from
    function attribution() { return (!('source' in request.resource.data) || request.resource.data.source is map)
                                 && optStr('page', 200); }

    // Public catalogue: anyone reads, admins and the marketing team write (Admin → Content)
    match /products/{id} { allow read: if true; allow write: if isMarketing(); }
    match /projects/{id} { allow read: if true; allow write: if isMarketing(); }
    match /events/{id}   { allow read: if true; allow write: if isMarketing(); } // Community events and workshops
    match /courses/{id}  { allow read: if true; allow write: if isMarketing(); }
    match /templates/{id}    { allow read: if true; allow write: if isMarketing(); } // template home designs
    match /developments/{id} { allow read: if true; allow write: if isMarketing(); } // real-estate developments
    match /downloads/{id}    { allow read: if true; allow write: if isMarketing(); } // free downloads (lead magnets)

    // Site settings: settings/site = page switches, contact details, motion (public read, admin write);
    // settings/studio = Marketing Studio options (team only)
    match /settings/{id} {
      allow read: if id != 'studio' || isEditor();
      allow write: if isAdmin() || (id == 'studio' && isMarketing());
    }

    // Team members by email (Admin → Team); the onTeamChange function turns them into custom claims.
    // Only the owner adds, changes or removes people (owner, 2026-10-24).
    match /team/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email.lower() == email);
      allow write: if isSiteOwner();
    }

    // Site text (Admin → Copy). copy/{page} = published text, public (visitors and the build read it);
    // copyDrafts/{page} = unpublished edits, team only; copy/{page}/history = who changed what, team only,
    // add-only. { items: { [id]: { text, size } } }. The tagline can never be published (Brand Guide).
    function copyDoc() {
      return request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 300
        && !request.resource.data.items.keys().hasAny(['tagline'])
        && request.resource.data.updatedAt == request.time;
    }
    match /copy/{page} {
      allow read: if true;
      allow create, update: if isAdmin() && copyDoc();
      allow delete: if isAdmin();
      match /history/{id} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['key', 'from', 'to', 'size', 'action', 'by', 'at'])
          && request.resource.data.key is string && request.resource.data.key.size() <= 60
          && request.resource.data.by == request.auth.token.email
          && request.resource.data.at == request.time;
      }
    }
    match /copyDrafts/{page} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && copyDoc();
    }

    // Marketing Studio (Admin → Studio): channels, occasions, topic ideas and the posts calendar
    match /socialChannels/{id} { allow read: if isEditor(); allow write: if isMarketing(); }
    match /occasions/{id}      { allow read: if isEditor(); allow write: if isMarketing(); }
    match /socialTopics/{id} {
      allow read: if isEditor();
      allow create: if isMarketing() || (isEditor() && request.resource.data.get('uses', 0) == 0);
      allow update, delete: if isMarketing();
    }
    match /socialPosts/{id} {
      allow read: if isEditor();
      allow create: if isMarketing()
        || (isEditor() && editorStatus(request.resource.data.status)
            && !request.resource.data.keys().hasAny(['approvedBy', 'results']));
      allow update: if isMarketing()
        || (isEditor() && editorStatus(resource.data.status) && editorStatus(request.resource.data.status)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvedBy', 'results']));
      allow delete: if isMarketing();
    }
    match /stats/{id}    { allow read: if true; allow write: if false; } // functions only

    // Users and their carts
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && !request.resource.data.diff(resource == null ? {} : resource.data)
             .affectedKeys().hasAny(['roles']);
      match /cart/{item} { allow read, write: if isOwner(uid); }
    }

    // Community profiles: public once approved
    match /members/{uid} {
      allow read: if resource.data.approved == true || isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.approved == (resource == null ? false : resource.data.approved);
      allow update, delete: if isAdmin(); // admin approves profiles
    }

    // Money: written only by Cloud Functions (Admin SDK bypasses rules)
    match /orders/{id}      { allow read: if isOwner(resource.data.uid) || isAdmin(); allow write: if false; }
    match /enrolments/{id}  { allow read: if isOwner(resource.data.uid) || isAdmin(); allow write: if false; }
    match /donations/{id}   { allow read: if resource.data.showOnWall == true || isOwner(resource.data.uid) || isAdmin(); allow write: if false; }

    // Forms: anyone submits (checked fields only); the team reads and sets a status (Admin → Leads)
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'body', 'source', 'page', 'createdAt'])
        && str('name', 120) && str('email', 200) && str('body', 5000)
        && attribution()
        && request.resource.data.createdAt == request.time;
      allow read, update: if isMarketing();
      allow delete: if isAdmin();
    }
    match /quotes/{id} {
      allow create: if !('status' in request.resource.data)
        && str('name', 120) && str('contact', 200)
        && attribution()
        && request.resource.data.createdAt == request.time;
      allow read, update: if isMarketing();
    }
    match /investorLeads/{id} {
      allow create: if !('status' in request.resource.data)
        && str('name', 120) && str('email', 200)
        && attribution()
        && request.resource.data.createdAt == request.time;
      allow read, update: if isMarketing();
    }

    // Email list (SubscribeForm): consent required; the team reads, sets a status, removes people
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'name', 'interests', 'consent', 'download', 'source', 'page', 'createdAt'])
        && str('email', 200)
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.consent == true
        && optStr('name', 120) && optStr('download', 80)
        && (!('interests' in request.resource.data) || (request.resource.data.interests is list && request.resource.data.interests.size() <= 10))
        && attribution()
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isMarketing();
    }

    // Contact clicks (phone, WhatsApp, email, socials, marked buttons) for the Leads dashboard.
    // (Not `events`: that collection holds the Community events and workshops.)
    match /clicks/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'target', 'page', 'source', 'createdAt'])
        && request.resource.data.type in ['whatsapp', 'phone', 'email', 'cta', 'social']
        && str('target', 300) && optStr('page', 200)
        && (!('source' in request.resource.data) || request.resource.data.source is map)
        && request.resource.data.createdAt == request.time;
      allow read: if isMarketing();
      allow delete: if isAdmin();
    }

    // Jobs board: approved members post
    match /jobs/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.postedBy == request.auth.uid
        && get(/databases/$(db)/documents/members/$(request.auth.uid)).data.approved == true;
      allow update: if isAdmin()
        || (isOwner(resource.data.postedBy)
            && request.resource.data.postedBy == resource.data.postedBy);
      allow delete: if isAdmin() || isOwner(resource.data.postedBy);
    }

    // Journal (only if kept)
    match /posts/{id} { allow read: if true; allow write: if isMarketing(); }
  }
}
